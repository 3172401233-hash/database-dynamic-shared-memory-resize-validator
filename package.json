{
  "name": "database-dynamic-shared-memory-resize-validator",
  "version": "1.0.0",
  "description": "数据库共享内存动态扩缩容阶段规划与回滚验证器（纯模拟，不操作真实数据库）",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "shm-resize": "src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node src/cli.js --current 512 --target 1024 --connections 8 --page-cache 256 --lock-table 64 --dirty-pages 120 --swapped-pages 16 --pressure 2048"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT"
}
